DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  <FilesMatch "\.(?:css|js|png|jpe?g|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

# Do not expose local tooling, archives, screenshots, or hidden files.
<FilesMatch "(?i)^(?:\.|.*\.zip$|server\.js|package(?:-lock)?\.json|site-screenshot\.png)$">
  Require all denied
</FilesMatch>

# These folders are not part of the public website deployment.
RedirectMatch 404 ^/(?:\.git|cloudflare-bot|node_modules|scripts|seo-migration|templates|tmp-imagegen-logo|comint-cpanel-ready-privacy-cookies)(?:/|$)

RewriteEngine On

# Keep one HTTPS, non-www version of every indexable URL.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.comint\.by$ [NC]
RewriteRule ^ https://comint.by%{REQUEST_URI} [R=301,L,NE]

# Redirect legacy parameter-based product cards to their static SEO URLs.
RewriteCond %{QUERY_STRING} (^|&)slug=([^&]+)(&|$) [NC]
RewriteRule ^catalog-item(?:\.html)?$ /services/%2? [R=301,L,NE]
RewriteRule ^catalog-item(?:\.html)?$ - [R=404,L]

RewriteRule ^polygraphy/?$ /cifrovaya-pechat/ [R=301,L,NE]
RewriteRule ^souvenirs/?$ /suveniryi/ [R=301,L,NE]

# SEO:MIGRATION-REDIRECTS:START
